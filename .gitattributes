# Text files are LF in the working tree on every machine, whatever core.autocrlf says.
# TEXTMAP and the scripts stay byte-identical to what's committed.
* text=auto eol=lf

# Windows batch files need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files.
*.wad binary
*.pk3 binary
*.png binary
*.zip binary
